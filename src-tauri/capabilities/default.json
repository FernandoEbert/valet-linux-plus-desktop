{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: valet state and actions, folder picker, confirmations, opening sites and folders",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
